FROM alpine:3.22 AS release

ARG SPOOFDPI_VERSION=1.3.1
ARG SPOOFDPI_ARCHIVE_SHA256=d4e463e19c37e2a4024207a163c0fe6656f793f428cd6992b892365d614695a8

RUN apk add --no-cache ca-certificates curl tar

WORKDIR /tmp/spoofdpi

RUN spoofdpi_archive="spoofdpi_${SPOOFDPI_VERSION}_linux_arm64.tar.gz" \
  && spoofdpi_release_url="https://github.com/xvzc/spoofdpi/releases/download/v${SPOOFDPI_VERSION}" \
  && curl -fsSLo "${spoofdpi_archive}" "${spoofdpi_release_url}/${spoofdpi_archive}" \
  && echo "${SPOOFDPI_ARCHIVE_SHA256}  ${spoofdpi_archive}" | sha256sum -c - \
  && tar -xzf "${spoofdpi_archive}" \
  && install -m 0755 spoofdpi /spoofdpi

FROM scratch

COPY --from=release /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=release /spoofdpi /spoofdpi

USER 65532:65532

ENTRYPOINT ["/spoofdpi"]
