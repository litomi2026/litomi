{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "#reader/*": ["./src/*"],
      "#ui/*": ["../ui/src/*"],
      "@litomi/ui": ["../ui/src/index.ts"]
    },
    "types": ["json", "node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
