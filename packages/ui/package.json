{
  "name": "@litomi/ui",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "license": "GPL-3.0-only",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "imports": {
    "#ui/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../tools/buildReactPackage.ts .",
    "type": "tsc -p tsconfig.dev.json --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
