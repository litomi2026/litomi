{
  "name": "@litomi/db",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app/activity": "./src/app/activity.ts",
    "./app/auth": "./src/app/auth.ts",
    "./app/bbaton": "./src/app/bbaton.ts",
    "./app/censorship": "./src/app/censorship.ts",
    "./app/dmca": "./src/app/dmca.ts",
    "./app/library": "./src/app/library.ts",
    "./app/notification": "./src/app/notification.ts",
    "./app/passkey": "./src/app/passkey.ts",
    "./app/points": "./src/app/points.ts",
    "./app/post": "./src/app/post.ts",
    "./app/report": "./src/app/report.ts",
    "./app/schema": "./src/app/schema.ts",
    "./app/two-factor": "./src/app/two-factor.ts",
    "./app/user": "./src/app/user.ts",
    "./app": "./src/app/db.ts",
    "./catalog/schema": "./src/catalog/schema.ts",
    "./catalog": "./src/catalog/db.ts",
    "./error": "./src/error.ts",
    "./query/bookmark": "./src/query/bookmark.ts",
    "./query/catalog-manga": "./src/query/catalog-manga.ts",
    "./query/library-item": "./src/query/library-item.ts",
    "./query/post-comment": "./src/query/post-comment.ts",
    "./query/post": "./src/query/post.ts",
    "./query/user-settings": "./src/query/user-settings.ts",
    "./redis": "./src/redis.ts",
    "./sql/collection-item-sort": "./src/sql/collection-item-sort.ts",
    "./sql/rating-sort": "./src/sql/rating-sort.ts"
  },
  "scripts": {
    "push:local": "bun run push:local:app && bun run push:local:catalog",
    "lint": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.gitignore",
    "push:local:app": "bun --env-file=.env.local drizzle-kit push --config=drizzle.app.config.ts --force && bun --env-file=.env.local scripts/app/syncAppSql.ts",
    "push:local:catalog": "bun --env-file=.env.local drizzle-kit push --config=drizzle.catalog.config.ts --force",
    "push:prod": "bun run push:prod:app && bun run push:prod:catalog",
    "push:prod:app": "test -f .env.prod && bun --env-file=.env.prod drizzle-kit push --config=drizzle.app.config.ts && bun --env-file=.env.prod scripts/app/syncAppSql.ts",
    "push:prod:catalog": "test -f .env.prod && bun --env-file=.env.prod drizzle-kit push --config=drizzle.catalog.config.ts",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@litomi/domain": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/std": "workspace:*",
    "@upstash/redis": "^1.37.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
