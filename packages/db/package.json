{
  "name": "@litomi/db",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cursor": "./src/cursor.ts",
    "./app/activity": "./src/app/schema/activity.ts",
    "./app/auth": "./src/app/schema/auth.ts",
    "./app/bbaton": "./src/app/schema/bbaton.ts",
    "./app/chat": "./src/app/schema/chat.ts",
    "./app/censorship": "./src/app/schema/censorship.ts",
    "./app/dmca": "./src/app/schema/dmca.ts",
    "./app/library": "./src/app/schema/library.ts",
    "./app/recommendation": "./src/app/schema/recommendation.ts",
    "./app/notification": "./src/app/schema/notification.ts",
    "./app/passkey": "./src/app/schema/passkey.ts",
    "./app/points": "./src/app/schema/points.ts",
    "./app/post": "./src/app/schema/post.ts",
    "./app/report": "./src/app/schema/report.ts",
    "./app/schema": "./src/app/schema/index.ts",
    "./app/two-factor": "./src/app/schema/two-factor.ts",
    "./app/user": "./src/app/schema/user.ts",
    "./app": "./src/app/db.ts",
    "./catalog/schema": "./src/catalog/schema.ts",
    "./catalog": "./src/catalog/db.ts",
    "./error": "./src/error.ts",
    "./chat/db": "./src/chat/db.ts",
    "./chat/schema": "./src/chat/schema.ts",
    "./chat/query": "./src/chat/query/index.ts",
    "./app/query/bookmark": "./src/app/query/bookmark.ts",
    "./app/query/chat": "./src/app/query/chat.ts",
    "./catalog/query": "./src/catalog/query.ts",
    "./app/query/library-item": "./src/app/query/library-item.ts",
    "./app/query/post-comment": "./src/app/query/post-comment.ts",
    "./app/query/post": "./src/app/query/post.ts",
    "./app/query/user": "./src/app/query/user.ts",
    "./app/query/user-settings": "./src/app/query/user-settings.ts",
    "./sql/library-item-sort": "./src/sql/library-item-sort.ts",
    "./sql/rating-sort": "./src/sql/rating-sort.ts"
  },
  "scripts": {
    "type": "tsc --noEmit",
    "push": "bun run push:local",
    "push:local": "bun run push:local:app && bun run push:local:catalog && bun run push:local:chat",
    "push:local:app": "bun --env-file=.env.local drizzle-kit push --config=drizzle.app.config.ts --force && bun --env-file=.env.local scripts/app/syncAppSql.ts",
    "push:local:catalog": "bun --env-file=.env.local drizzle-kit push --config=drizzle.catalog.config.ts --force",
    "push:local:chat": "bun --env-file=.env.local drizzle-kit push --config=drizzle.chat.config.ts --force",
    "push:prod": "bun run push:prod:app && bun run push:prod:catalog && bun run push:prod:chat",
    "push:prod:app": "test -f .env.prod && bun --env-file=.env.prod drizzle-kit push --config=drizzle.app.config.ts && bun --env-file=.env.prod scripts/app/syncAppSql.ts",
    "push:prod:catalog": "test -f .env.prod && bun --env-file=.env.prod drizzle-kit push --config=drizzle.catalog.config.ts",
    "push:prod:chat": "test -f .env.prod && bun --env-file=.env.prod drizzle-kit push --config=drizzle.chat.config.ts"
  },
  "dependencies": {
    "@litomi/domain": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/std": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "ulid": "^3.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
