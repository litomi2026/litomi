{
  "name": "@litomi/db",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./database/catalog/drizzle": "./src/database/catalog/drizzle.ts",
    "./database/catalog/schema": "./src/database/catalog/schema.ts",
    "./database/error": "./src/database/error.ts",
    "./database/redis": "./src/database/redis.ts",
    "./database/app/activity": "./src/database/app/activity.ts",
    "./database/app/auth": "./src/database/app/auth.ts",
    "./database/app/bbaton": "./src/database/app/bbaton.ts",
    "./database/app/censorship": "./src/database/app/censorship.ts",
    "./database/app/dmca": "./src/database/app/dmca.ts",
    "./database/app/drizzle": "./src/database/app/drizzle.ts",
    "./database/app/library": "./src/database/app/library.ts",
    "./database/app/notification": "./src/database/app/notification.ts",
    "./database/app/passkey": "./src/database/app/passkey.ts",
    "./database/app/points": "./src/database/app/points.ts",
    "./database/app/post": "./src/database/app/post.ts",
    "./database/app/report": "./src/database/app/report.ts",
    "./database/app/schema": "./src/database/app/schema.ts",
    "./database/app/two-factor": "./src/database/app/two-factor.ts",
    "./database/app/user": "./src/database/app/user.ts",
    "./query/user-settings.query": "./src/query/user-settings.query.ts",
    "./sql/collection-item-sort": "./src/sql/collection-item-sort.ts",
    "./sql/rating-sort": "./src/sql/rating-sort.ts",
    "./sql/selectBookmark": "./src/sql/selectBookmark.ts",
    "./sql/selectLibraryItem": "./src/sql/selectLibraryItem.ts",
    "./sql/selectPost": "./src/sql/selectPost.ts",
    "./sql/selectPostComment": "./src/sql/selectPostComment.ts"
  },
  "scripts": {
    "grant:libo": "bun --conditions=react-server scripts/grantLibo.ts",
    "push:local": "bun run push:local:app && bun run push:local:catalog",
    "push:local:app": "bun --env-file=../../.env.development drizzle-kit push --config=drizzle.app.config.ts && bun --env-file=../../.env.development scripts/app/pushAppFunction.ts",
    "push:local:catalog": "bun --env-file=../../.env.development drizzle-kit push --config=drizzle.catalog.config.ts",
    "push:stg": "bun run push:stg:app && bun run push:stg:catalog",
    "push:stg:app": "bun --env-file=../../.env.stg drizzle-kit push --config=drizzle.app.config.ts && bun --env-file=../../.env.stg scripts/app/pushAppFunction.ts",
    "push:stg:catalog": "bun --env-file=../../.env.stg drizzle-kit push --config=drizzle.catalog.config.ts",
    "push:prod": "bun run push:prod:app && bun run push:prod:catalog",
    "push:prod:app": "bun --env-file=../../.env.production drizzle-kit push --config=drizzle.app.config.ts && bun --env-file=../../.env.production scripts/app/pushAppFunction.ts",
    "push:prod:catalog": "bun --env-file=../../.env.production drizzle-kit push --config=drizzle.catalog.config.ts",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@litomi/contracts": "workspace:*",
    "@litomi/domain": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/std": "workspace:*",
    "@upstash/redis": "^1.37.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
