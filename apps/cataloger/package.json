{
  "name": "@litomi/cataloger",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --conditions=react-server --minify --sourcemap src/index.ts --target=bun --outfile dist/cataloger",
    "start": "bun run start:local",
    "start:local": "bun --conditions=react-server --env-file=.env.local src/index.ts",
    "start:prod": "bun --conditions=react-server --env-file=.env.prod.runtime src/index.ts",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t litomi-cataloger-local ../..",
    "docker:run": "docker run --rm --env-file .env.prod.runtime litomi-cataloger-local"
  },
  "dependencies": {
    "@litomi/catalog": "workspace:*",
    "@litomi/crawler": "workspace:*",
    "@litomi/db": "workspace:*",
    "@litomi/domain": "workspace:*",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  }
}
