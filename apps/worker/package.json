{
  "name": "@litomi/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun run --env-file=.env.local --watch src/index.ts",
    "dev:prod": "bun run --env-file=.env.prod.dev --watch src/index.ts",
    "build": "bun build --compile --minify --sourcemap src/index.ts --target=bun --outfile dist/litomi-worker",
    "start": "bun run start:prod",
    "start:local": "bun --env-file=.env.local src/index.ts",
    "start:prod": "bun --env-file=.env.prod.runtime src/index.ts",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t litomi-worker-local ../..",
    "docker:run": "docker run --rm --env-file .env.prod.runtime litomi-worker-local"
  },
  "dependencies": {
    "@litomi/db": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/events": "workspace:*",
    "@litomi/kv": "workspace:*",
    "@litomi/notifications": "workspace:*",
    "@litomi/std": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^5.9.3"
  }
}
