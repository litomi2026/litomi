{
  "name": "@litomi/catalog-ingest",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --conditions=react-server --minify --sourcemap src/index.ts --target=bun --outfile dist/catalog-ingest",
    "docker:build": "docker build -f Dockerfile -t litomi-catalog-ingest-local ../..",
    "docker:run": "docker run --rm --env-file ../../infra/cloud-run/catalog-ingest/.env litomi-catalog-ingest-local",
    "start": "bun --conditions=react-server src/index.ts",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@litomi/catalog": "workspace:*",
    "@litomi/crawler": "workspace:*",
    "@litomi/db": "workspace:*",
    "@litomi/domain": "workspace:*",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  }
}
