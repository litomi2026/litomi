{
  "name": "@litomi/web",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun --env-file=.env.local next dev --port 3000",
    "dev:prod": "bun --env-file=.env.prod.dev next dev --port 3000",
    "build": "bun --env-file=.env.prod.build next build",
    "build:analyze": "ANALYZE=true bun --env-file=.env.prod.build next build --webpack",
    "start": "bun run start:prod",
    "start:local": "bun --env-file=.env.local next start --port 3000",
    "start:prod": "bun --env-file=.env.prod.runtime next start --port 3000",
    "type": "bun --env-file=.env.local.example next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.39.0",
    "@amplitude/analytics-node": "^1.5.53",
    "@capacitor/core": "8.3.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@grafana/faro-web-sdk": "^2.7.1",
    "@grafana/faro-web-tracing": "^2.7.1",
    "@litomi/auth": "workspace:*",
    "@litomi/catalog": "workspace:*",
    "@litomi/contracts": "workspace:*",
    "@litomi/crawler": "workspace:*",
    "@litomi/db": "workspace:*",
    "@litomi/domain": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/http": "workspace:*",
    "@litomi/image-reader": "workspace:*",
    "@litomi/observability": "workspace:*",
    "@litomi/std": "workspace:*",
    "@litomi/ui": "workspace:*",
    "@marsidev/react-turnstile": "^1.5.0",
    "@mlc-ai/web-llm": "^0.2.82",
    "@next/third-parties": "16.1.7",
    "@sentry/nextjs": "10.47.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@suspensive/react": "^3.20.2",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-devtools": "^5.97.0",
    "@vercel/otel": "^2.1.2",
    "@zip.js/zip.js": "^2.8.26",
    "bcryptjs": "^3.0.3",
    "country-flag-icons": "^1.6.15",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.45.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.17.0",
    "masonic": "^4.1.0",
    "ms": "^2.1.3",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "otplib": "^13.4.0",
    "p-limit": "^7.3.0",
    "p-throttle": "^8.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-textarea-autosize": "^8.5.9",
    "react-window": "^2.2.7",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.1.7",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/query-core": "^5.97.0",
    "@types/country-flag-icons": "^1.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  }
}
