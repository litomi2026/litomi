{
  "name": "@litomi/recommender",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap src/index.ts --target=bun --outfile dist/recommender",
    "start": "bun run start:local",
    "start:local": "bun --env-file=.env.local src/index.ts",
    "start:prod": "bun --env-file=.env.prod.runtime src/index.ts",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t litomi-recommender-local ../..",
    "docker:run": "docker run --rm --env-file .env.prod.runtime litomi-recommender-local",
    "opensearch:local": "bun --env-file=.env.local src/opensearch-sync.ts",
    "opensearch:prod": "bun --env-file=.env.prod.runtime src/opensearch-sync.ts"
  },
  "dependencies": {
    "@litomi/catalog": "workspace:*",
    "@litomi/db": "workspace:*",
    "@litomi/domain": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
