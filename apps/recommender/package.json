{
  "name": "@litomi/recommender",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap src/index.ts --target=bun --outfile dist/recommender",
    "start": "bun run generate:local",
    "generate:local": "bun --env-file=.env.local src/index.ts generate",
    "generate:prod": "bun --env-file=.env.prod.runtime src/index.ts generate",
    "sync-index:local": "bun --env-file=.env.local src/index.ts sync-index",
    "sync-index:prod": "bun --env-file=.env.prod.runtime src/index.ts sync-index",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t litomi-recommender-local ../..",
    "docker:run": "docker run --rm --env-file .env.prod.runtime litomi-recommender-local generate"
  },
  "dependencies": {
    "@litomi/catalog": "workspace:*",
    "@litomi/db": "workspace:*",
    "@litomi/domain": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
