{
  "name": "@litomi/proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun run --env-file=.env.local --watch src/server.ts",
    "dev:prod": "bun run --env-file=.env.prod.dev --watch src/server.ts",
    "build": "bun build --compile --minify --sourcemap src/server.ts --target=bun --outfile dist/litomi-proxy",
    "start": "bun run start:prod",
    "start:local": "bun --env-file=.env.local src/server.ts",
    "start:prod": "bun --env-file=.env.prod.runtime src/server.ts",
    "type": "tsc --noEmit",
    "docker:build": "docker build -f Dockerfile -t litomi-proxy-local ../..",
    "docker:run": "docker run --rm -p 3001:3001 --env-file .env.prod.runtime litomi-proxy-local"
  },
  "dependencies": {
    "@litomi/catalog": "workspace:*",
    "@litomi/crawler": "workspace:*",
    "@litomi/domain": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/http": "workspace:*",
    "@litomi/std": "workspace:*",
    "@sentry/core": "10.62.0",
    "hono": "^4.12.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
