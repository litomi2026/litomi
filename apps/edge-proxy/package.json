{
  "name": "@litomi/edge-proxy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "bun --env-file=.env.local next dev --port 3001",
    "dev:prod": "bun --env-file=.env.prod.dev next dev --port 3001",
    "build": "bun --env-file=.env.prod.build next build",
    "start": "bun run start:prod",
    "start:local": "bun --env-file=.env.local next start --port 3001",
    "start:prod": "bun --env-file=.env.prod.runtime next start --port 3001",
    "type": "tsc --noEmit"
  },
  "dependencies": {
    "@litomi/catalog": "workspace:*",
    "@litomi/crawler": "workspace:*",
    "@litomi/domain": "workspace:*",
    "@litomi/env": "workspace:*",
    "@litomi/http": "workspace:*",
    "@litomi/observability": "workspace:*",
    "@litomi/std": "workspace:*",
    "@sentry/nextjs": "10.62.0",
    "@vercel/functions": "^3.7.4",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3"
  }
}
