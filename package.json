{
  "name": "litomi",
  "version": "1.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "turbo dev --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "dev:prod": "turbo dev:prod --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "build": "turbo build",
    "start": "bun run start:prod",
    "start:local": "turbo start:local --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "start:prod": "turbo start:prod --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "type": "turbo run type type:root",
    "type:root": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check --write .",
    "format": "prettier --write '**/*.{css,md,yml,yaml,html}'",
    "format:sql": "git ls-files '*.sql' | xargs -n 1 sql-formatter --fix -l postgresql",
    "prepare": "husky",
    "clean": "rm -rf .next .turbo apps/web/.next apps/edge-proxy/.next apps/api/dist apps/cataloger/dist apps/notifier/dist node_modules/.cache",
    "db:reset": "docker compose down -v && docker compose up -d --wait && bun --filter=@litomi/db push:local",
    "test": "bun test",
    "test:backend:integration": "bun tools/setupBackendIntegrationDb.ts && bun test ./test/backend --max-concurrency 1",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ms": "^2.1.3",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.9",
    "prettier": "^3.8.5",
    "sql-formatter": "^15.8.2",
    "turbo": "^2.10.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
