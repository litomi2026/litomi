{
  "name": "litomi",
  "version": "1.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:local",
    "dev:local": "turbo dev --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "dev:prod": "turbo dev:prod --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "build": "turbo build",
    "start": "bun run start:prod",
    "start:local": "turbo start:local --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "start:prod": "turbo start:prod --filter=@litomi/web --filter=@litomi/edge-proxy --filter=@litomi/api",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --fix . --ignore-pattern apps/** --ignore-pattern packages/**",
    "format": "turbo run format format:root",
    "format:root": "prettier --write '*.{js,mjs,cjs,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,html}' '.prettierrc' '.vscode/**/*.{json,jsonc,md}' 'infra/**/*.{js,mjs,cjs,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,html}' 'k8s/**/*.{js,mjs,cjs,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,html}' 'test/**/*.{js,mjs,cjs,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,html}' 'tools/**/*.{js,mjs,cjs,ts,tsx,json,jsonc,md,mdx,yml,yaml,css,html}' --ignore-path .gitignore",
    "type": "tsc -p tsconfig.json --noEmit && turbo type",
    "prepare": "husky",
    "clean": "rm -rf .next .turbo apps/web/.next apps/edge-proxy/.next apps/api/dist apps/cataloger/dist apps/notifier/dist node_modules/.cache",
    "db:reset": "docker compose down -v && docker compose up -d --wait && bun --filter=@litomi/db push:local",
    "test": "bun test",
    "test:backend:integration": "bun tools/setupBackendIntegrationDb.ts && bun test ./test/backend --max-concurrency 1",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.4",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-next": "16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.8.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ms": "^2.1.3",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.9",
    "prettier": "3.8.1",
    "turbo": "^2.9.12",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  }
}
